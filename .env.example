# =============================================================================
# BLVCKSHELL — Single env file for Portal + Marketing (same database)
# =============================================================================
# Copy this file to .env at repo root and fill in values.
# Both portal and marketing read from this file when run from repo root or when
# each app loads ../.env (silent). On Vercel, set these in Project Settings.
# =============================================================================

# --- Database (shared by Portal and Marketing) ---
# Supabase POOLER = runtime (Session mode 5432). Add pgbouncer params for serverless.
DATABASE_URL="postgresql://postgres.oscqetgchujqzvasjdga:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Prisma CLI (migrate / db pull). If P1001 on direct host, use SESSION POOLER URL here (same host as above, different use).
DIRECT_URL="postgresql://postgres.oscqetgchujqzvasjdga:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Supabase Storage (Portal: evidence + compliance docs) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- NextAuth (Portal only) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-change-in-production"

# --- Stripe (client payments) ---
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
# Get from Stripe Dashboard > Developers > Webhooks > Signing secret
STRIPE_WEBHOOK_SECRET=""

# --- SendGrid (email notifications) ---
# Get from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@blvckshell.com"

# --- Twilio (SMS notifications) ---
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Upstash Redis (distributed rate limiting) ---
# Get from https://console.upstash.com — create a Redis database
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Notification Worker (cron job auth) ---
CRON_SECRET=""

# --- Marketing only (optional) ---
# Portal URL for "Portal / Log in" link on marketing site
NEXT_PUBLIC_PORTAL_URL="http://localhost:3000"
# Marketing site URL for sitemap/robots
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# --- App ---
NODE_ENV="development"
